{
  "name": "@sonojot/transcribe",
  "version": "0.1.0",
  "private": true,
  "description": "SonoJot's speech-to-text pipeline in the browser: speech recognition, punctuation and conservative cleanup, all on the user's device.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./language": "./src/language.ts",
    "./text": "./src/text/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.host.json",
    "test": "tsx --test test/*.test.ts",
    "demo": "vite --host 127.0.0.1 --port 5317 --strictPort",
    "build:demo": "vite build",
    "measure": "tsx scripts/measure.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "onnxruntime-common": "1.31.1",
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.18.0",
    "onnxruntime-node": "1.31.1",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.4"
  }
}
