---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import CleanupDemo from "../components/CleanupDemo.astro";
import Meetings from "../components/Meetings.astro";
import Local from "../components/Local.astro";
import Install from "../components/Install.astro";
import Footer from "../components/Footer.astro";
import { homeStructuredData, jsonLd, latestVersion } from "../structured-data.mjs";

const structuredData = jsonLd(homeStructuredData(await latestVersion()));
---

<Base description="Free, open-source dictation and meeting transcription for Windows and Mac. Press a key, speak, and text appears at your cursor. Speech to text runs offline.">
  <script slot="head" type="application/ld+json" is:inline set:html={structuredData} />
  <Nav />
  <main id="main">
    <Hero />
    <CleanupDemo />
    <Meetings />
    <Local />
    <Install />
  </main>
  <Footer />
</Base>
