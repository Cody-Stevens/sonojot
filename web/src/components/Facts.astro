---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="facts">
  {
    items.map((item) => (
      <li>
        <span class="rule" aria-hidden="true" />
        {item}
      </li>
    ))
  }
</ul>

<style>
  .facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.02rem;
    line-height: 1.45;
  }

  .facts li {
    display: grid;
    gap: 0.7rem;
  }

  .rule {
    display: block;
    width: 2.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--dye);
    opacity: 0.55;
  }
</style>
