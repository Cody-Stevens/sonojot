{
  "name": "sonojot",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.26.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "test": "tsx --test src/lib/*.test.ts",
    "test:ui": "playwright test",
    "format": "prettier --plugin prettier-plugin-svelte --write src index.html package.json tsconfig.json tsconfig.node.json vite.config.ts svelte.config.js",
    "format:check": "prettier --plugin prettier-plugin-svelte --check src index.html package.json tsconfig.json tsconfig.node.json vite.config.ts svelte.config.js",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "svelte": "^5.38.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.18.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
