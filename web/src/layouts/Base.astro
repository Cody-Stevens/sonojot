---
import "../styles/paper.css";
import "../../../shared/typography-material.css";
import { site } from "../site.config.mjs";

interface Props {
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name}: ${site.titleLine}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, ""), site.origin).href;
const ogImage = new URL("/og.jpg", site.origin).href;
---

<!doctype html>
<html lang="en" data-theme="fog">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/brand/sonojot-favicon-tile.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="The SonoJot signature printed on cream stock, with the line: Your voice, in writing." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f9f7ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151815" media="(prefers-color-scheme: dark)" />

    <link
      rel="preload"
      href="/fonts/SourceSerif4Var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline>
      // Runs before first paint so the stock is never the wrong colour.
      (function () {
        document.documentElement.classList.add("has-js");
        try {
          var saved = localStorage.getItem("sonojot-theme");
          var prefersDark =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = saved || (prefersDark ? "basalt" : "fog");
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          /* keep the default Fog stock */
        }
      })();
    </script>
  </head>

  <body class="type-material">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="desk-plane" aria-hidden="true"></div>

    <slot />

    <script>
      import { mountTypographyMaterial } from "../../../shared/typography-material";
      mountTypographyMaterial(document.body);

      // Paper is laid down as it comes into view. One observer for the page.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");

      if (reduced || !("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-revealed"));
      } else {
        const seen = new WeakSet<Element>();
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting || seen.has(entry.target)) continue;
              seen.add(entry.target);
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.08 },
        );

        // Anything already on screen settles immediately on load, in order.
        targets.forEach((el) => {
          const box = el.getBoundingClientRect();
          if (box.top < window.innerHeight * 0.94) {
            seen.add(el);
            requestAnimationFrame(() => el.classList.add("is-revealed"));
          } else {
            observer.observe(el);
          }
        });
      }
    </script>
  </body>
</html>
